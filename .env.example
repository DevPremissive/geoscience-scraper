# Copy to .env and fill in. .env is gitignored.

# Ocp-Apim-Subscription-Key for the GeologyOntario Elasticsearch API
# (ws.apis.lrc.gov.on.ca), used by the Ontario AMIS/OAFD connectors.
# Ontario ships this key in the public Angular SPA at
# https://www.geologyontario.mines.gov.on.ca — recover it from main.js.
CANADA_GEO_ON_API_KEY=

# Optional path overrides (defaults are in src/config.py)
# CANADA_GEO_LAKE=/media/vis/Expansion/canada-geo-lake
# CANADA_GEO_INDEX=/home/vis/infra/canada-geo-lake-data
